<div id="pilots-tab" class="tab-content">
    <div class="add-job-section">
      <h2>Adicionar Novo Piloto</h2>
      <form id="addPilotForm">
        <div class="form-group">
          <label for="pilotName">Nome</label>
          <input type="text" id="pilotName" name="name" required>
        </div>
        
        <div class="form-group">
          <label for="pilotCallsign">Codinome</label>
          <input type="text" id="pilotCallsign" name="callsign" required>
        </div>
        
        <div class="form-group">
          <label for="pilotLL">Nível de Licença (0-12)</label>
          <input type="number" id="pilotLL" name="ll" min="0" max="12" value="0" required>
        </div>
        
        <div class="form-group">
          <label for="pilotNotes">Notas (multilinha)</label>
          <textarea id="pilotNotes" name="notes" rows="4" placeholder="Opcional"></textarea>
        </div>

        <div class="form-group">
          <label for="pilotAdminLog">Registro do Administrador</label>
          <textarea id="pilotAdminLog" name="adminLog" rows="3" placeholder="Notas exclusivas do Mestre para este piloto"></textarea>
        </div>

        <div class="form-group" id="addPilotPersonalOperationProgressGroup" style="display: <%= settings.openTable ? 'block' : 'none' %>">
          <label for="pilotPersonalOperationProgress">Progresso Pessoal da Operação</label>
          <select id="pilotPersonalOperationProgress" name="personalOperationProgress">
            <option value="0" selected>0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
          </select>
        </div>
        
        <div class="form-group">
          <label style="display: block; cursor: pointer;">
            <span style="display: inline; margin-right: 8px;">Ativo:</span>
            <input type="checkbox" id="pilotActive" name="active" value="true" checked style="width: auto;">
          </label>
        </div>
        
        <button type="submit" class="btn btn-primary btn-add-job">Adicionar Piloto</button>
      </form>
    </div>

    <div class="jobs-list">
      <h2>Pilotos Existentes</h2>
      
      <!-- Progress Operation Button (only visible when openTable is ON) -->
      <div id="progressOperationButtonContainer" style="margin-bottom: 20px; display: <%= settings.openTable ? 'block' : 'none' %>;">
        <button class="btn btn-neutral" onclick="showProgressOperationModal()" style="font-size: 14px; padding: 10px 20px;">
          Avançar a Trilha de Operação dos Pilotos Ativos
        </button>
      </div>
      
      <div id="pilotsList">
        <% if (pilots.length === 0) { %>
          <p style="color: #b0b0b0;">Nenhum piloto criado ainda.</p>
        <% } else { %>
          <% pilots.forEach(pilot => { %>
            <div class="job-item" data-id="<%= pilot.id %>">
              <h3><%= pilot.name %> ("<%= pilot.callsign %>") <% if (pilot.active) { %><span class="state-badge state-badge-active">ATIVO</span><% } else { %><span class="state-badge state-badge-ignored">INATIVO</span><% } %></h3>
              <div class="job-item-field"><strong>Nível de Licença:</strong> <%= pilot.ll %></div>
              <div class="job-item-field">
                <strong>Saldo:</strong> 
                <span class="pilot-balance" data-pilot-id="<%= pilot.id %>"><%= pilot.balance || 0 %></span>
                <img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon">
              </div>
              <% if (pilot.notes) { %>
                <div class="job-item-field"><strong>Notas:</strong><br><pre style="margin: 5px 0; font-family: inherit; white-space: pre-wrap;"><%= pilot.notes %></pre></div>
              <% } %>
              <% if (pilot.adminLog) { %>
                <div class="job-item-field"><strong>Registro do Administrador:</strong> <%= pilot.adminLog %></div>
              <% } %>
              <div class="job-item-field">
                <strong>Trabalhos Relacionados:</strong> <%= (pilot.relatedJobs || []).length %> trabalho(s)
              </div>
              <div class="job-item-field pilot-personal-operation-progress-display" style="display: <%= settings.openTable ? 'block' : 'none' %>">
                <strong>Progresso Pessoal da Operação:</strong> <%= pilot.personalOperationProgress ?? 0 %>
              </div>
              <div class="job-item-actions">
                <button class="btn btn-edit" onclick="editPilot('<%= pilot.id %>')">Editar</button>
                <button class="btn btn-neutral" onclick="openPilotRelatedJobsModal('<%= pilot.id %>')">Trabalhos Relacionados</button>
                <button class="btn btn-neutral" onclick="openPilotBalanceHistoryModal('<%= pilot.id %>')">Histórico de Saldo</button>
                <button class="btn btn-neutral" onclick="openPilotReservesModal('<%= pilot.id %>')">Editar Reservas</button>
                <button class="btn btn-delete" onclick="deletePilot('<%= pilot.id %>')">Excluir</button>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
