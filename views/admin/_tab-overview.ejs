<div id="overview-tab" class="tab-content active">
    <div class="settings-section">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="margin: 0;">Configurações Globais</h2>
        <button type="submit" form="settingsForm" class="btn btn-primary">Salvar Configurações</button>
      </div>
      <form id="settingsForm">
        <input type="hidden" id="settingsCurrencyIcon" name="currencyIcon" value="<%= settings.currencyIcon || 'manna_symbol.svg' %>">
        <div class="form-group">
          <label for="settingsPortalHeading">Cabeçalho do Portal (Tela de Entrada e Visão do Cliente)</label>
          <input type="text" id="settingsPortalHeading" name="portalHeading" value="<%= settings.portalHeading %>" maxlength="100" required>
        </div>
        
        <div class="form-group">
          <label for="settingsColorScheme">Esquema de Cores (Visão do Cliente e Tela de Entrada)</label>
          <select id="settingsColorScheme" name="colorScheme" required>
            <option value="grey" <%= settings.colorScheme === 'grey' ? 'selected' : '' %>>Cinza (Preto e Branco)</option>
            <option value="orange" <%= settings.colorScheme === 'orange' ? 'selected' : '' %>>Laranja (Estilo Portal)</option>
            <option value="green" <%= settings.colorScheme === 'green' ? 'selected' : '' %>>Verde (Terminal Clássico)</option>
            <option value="blue" <%= settings.colorScheme === 'blue' ? 'selected' : '' %>>Azul (Fundo Azul Escuro)</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="settingsUnt">DATA (Data - DD/MM/AAAA)</label>
          <input type="text" id="settingsUnt" name="unt" value="<%= settings.unt %>" placeholder="DD/MM/AAAA" pattern="\d{2}/\d{2}/\d{4}" required>
        </div>
        
        <div class="form-group">
          <label for="settingsGalacticPos">Posição Galáctica Atual</label>
          <input type="text" id="settingsGalacticPos" name="currentGalacticPos" value="<%= settings.currentGalacticPos %>" required>
        </div>
        
        <div class="form-group">
          <label for="settingsUserGroup">Grupo de Usuário</label>
          <input type="text" id="settingsUserGroup" name="userGroup" value="<%= settings.userGroup %>" maxlength="100" required>
        </div>
        
        <div class="form-group">
          <label for="settingsOperationProgress">Progresso da Operação (0-3)</label>
          <select id="settingsOperationProgress" name="operationProgress" required>
            <option value="0" <%= settings.operationProgress === 0 ? 'selected' : '' %>>0 - Inicial</option>
            <option value="1" <%= settings.operationProgress === 1 ? 'selected' : '' %>>1 - Em Desenvolvimento</option>
            <option value="2" <%= settings.operationProgress === 2 ? 'selected' : '' %>>2 - Avançado</option>
            <option value="3" <%= settings.operationProgress === 3 ? 'selected' : '' %>>3 - Crítico</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="settingsClientPassword">Senha do Piloto (Acesso ao Modo CLIENTE)</label>
          <input type="text" id="settingsClientPassword" name="clientPassword" value="<%= settings.clientPassword || '' %>" placeholder="Apenas alfanumérico, vazio para sem senha" pattern="[A-Za-z0-9]*">
          <small style="display: block; color: #b0b0b0; margin-top: 5px;">Apenas caracteres alfanuméricos são permitidos. Deixe vazio para permitir acesso sem senha.</small>
        </div>
        
        <div class="form-group">
          <label for="settingsAdminPassword">Senha do Administrador (Acesso ao Modo ADMIN)</label>
          <input type="text" id="settingsAdminPassword" name="adminPassword" value="<%= settings.adminPassword || '' %>" placeholder="Apenas alfanumérico, vazio para sem senha" pattern="[A-Za-z0-9]*">
          <small style="display: block; color: #b0b0b0; margin-top: 5px;">Apenas caracteres alfanuméricos são permitidos. Deixe vazio para permitir acesso sem senha.</small>
        </div>
        
        <div class="form-group">
          <label for="settingsOpenTable" style="display: inline-block; font-weight: bold; margin-bottom: 0;">
            Mesa Aberta (Mostrar progresso pessoal da operação do piloto)
          </label>
          <input type="checkbox" id="settingsOpenTable" name="openTable" value="true" <%= settings.openTable ? 'checked' : '' %> style="width: auto; margin-left: 10px; vertical-align: middle;">
        </div>
        
        <div class="form-group">
          <label>Ícone de Moeda</label>
          <button type="button" class="btn" onclick="openCurrencyIconModal()" style="margin-top: 5px;">
            Alterar Ícone de Moeda
          </button>
          <div style="display: flex; align-items: center; gap: 10px; margin-top: 10px;">
            <span style="color: #b0b0b0;">Atual:</span>
            <img id="currentCurrencyIconPreview" src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" style="width: 40px; height: 40px; border: 1px solid #444; padding: 5px; border-radius: 3px; background: white;">
            <span style="color: #e0e0e0;" id="currentCurrencyIconName"><%= settings.currencyIcon || 'manna_symbol.svg' %></span>
          </div>
        </div>
        
        <button type="submit" class="btn btn-primary">Salvar Configurações</button>
      </form>
    </div>
  </div>
