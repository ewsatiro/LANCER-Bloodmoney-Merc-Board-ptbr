<div id="jobs-tab" class="tab-content">
  <div class="add-job-section">
    <h2>Adicionar Novo Trabalho</h2>
    <form id="addJobForm">
      <div class="form-group">
        <label for="jobName">Nome do Trabalho</label>
        <input type="text" id="jobName" name="name" required>
      </div>
      
      <div class="form-group">
        <label for="jobRank">Nível do Trabalho (1-3 estrelas)</label>
        <select id="jobRank" name="rank" required>
          <option value="1">1 Estrela</option>
          <option value="2">2 Estrelas</option>
          <option value="3">3 Estrelas</option>
        </select>
      </div>
      
      <div class="form-group">
        <label for="jobState">Estado do Trabalho</label>
        <select id="jobState" name="state" required>
          <% jobStates.forEach(state => { %>
            <option value="<%= state %>" <%= state === defaultJobState ? 'selected' : '' %>><%= state %></option>
          <% }); %>
        </select>
      </div>
      
      <div class="form-group">
        <label for="jobFaction">Facção (Opcional)</label>
        <select id="jobFaction" name="factionId">
          <option value="">Nenhuma</option>
          <% factions.forEach(faction => { %>
            <option value="<%= faction.id %>"><%= faction.title %></option>
          <% }); %>
        </select>
      </div>
      
      <div class="form-group">
        <label for="jobType">Tipo de Trabalho</label>
        <input type="text" id="jobType" name="jobType" required>
      </div>
      
      <div class="form-group">
        <label for="jobDescription">Objetivo</label>
        <textarea id="jobDescription" name="description" required></textarea>
      </div>
      
      <div class="form-group">
        <label for="jobClientBrief">Resumo do Cliente</label>
        <textarea id="jobClientBrief" name="clientBrief" required></textarea>
      </div>
      
      <div class="form-group">
        <label for="jobCurrencyPay" class="currency-label">
          Pagamento em Moeda (ex.: 100m)
          <img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon">
        </label>
        <input type="text" id="jobCurrencyPay" name="currencyPay" required>
      </div>
      
      <div class="form-group">
        <label for="jobAdditionalPay">Pagamento Adicional</label>
        <input type="text" id="jobAdditionalPay" name="additionalPay">
      </div>
      
      <div class="form-group">
        <label for="jobAdminLog">Registro do Administrador</label>
        <textarea id="jobAdminLog" name="adminLog" rows="3" placeholder="Notas exclusivas do Mestre para este trabalho"></textarea>
      </div>
      
      <div class="form-group">
        <label for="jobEmblem">Emblema</label>
        <input type="hidden" id="jobEmblem" name="emblem" value="">
        <div class="emblem-grid" id="emblemGrid">
          <div class="emblem-option none" data-emblem="">
            [Nenhum]
          </div>
          <% emblems.forEach(emblem => { %>
            <div class="emblem-option" data-emblem="<%= emblem %>" title="<%= formatEmblemTitle(emblem) %>">
              <img src="/emblems/<%= emblem %>" alt="<%= formatEmblemTitle(emblem) %>">
            </div>
          <% }); %>
        </div>
      </div>
    </form>
	
<div class="button-group">
  <div class="button-container">
    <form id="uploadForm" class="form-inline" enctype="multipart/form-data">
      <input type="file" id="fileInput" class="is-hidden" name="myFile" accept="image/png,image/jpeg,image/bmp">
      <button type="button" class="btn btn-neutral"
        onclick="document.getElementById('fileInput').click();"
        title="Envia uma imagem e a converte para SVG">
        Enviar Emblema
      </button>
    </form>
    <p class="helper-text">Aceita PNG, JPEG, BMP (máx. 10MB)</p>
  </div>
  
  <div class="button-container">
    <button type="button" class="btn btn-delete" id="deleteEmblemBtn" onclick="deleteSelectedEmblem()"
      title="Exclui o emblema atualmente selecionado (se não estiver em uso por nenhum trabalho)">
      Excluir Emblema Selecionado
    </button>
    <p class="helper-text">Exclui o emblema selecionado se não estiver em uso</p>
  </div>
</div>

<button type="submit" class="btn btn-primary btn-add-job" form="addJobForm">Adicionar Trabalho</button>
	
  </div>

  <div class="jobs-list">
    <h2>Histórico de Trabalhos</h2>
    
    <!-- Progress All Jobs Button -->
    <div style="margin-bottom: 20px;">
      <button class="btn btn-neutral" onclick="showProgressAllJobsModal()" style="font-size: 14px; padding: 10px 20px;">
        Avançar Todos os Trabalhos
      </button>
      
      <% 
        const hasOngoingVotingPeriod = votingPeriods.find(p => p.state === 'Ongoing');
      %>
      <% if (hasOngoingVotingPeriod) { %>
        <div style="margin-top: 10px; padding: 10px; background-color: #3a2a1a; border: 1px solid #FFA726; border-radius: 3px;">
          <strong style="color: #FFA726;">⚠ Aviso:</strong>
          <span style="color: #e0e0e0;">
            Mover qualquer Trabalho Ativo para fora do estado Ativo arquivará automaticamente o Período de Votação atual.
          </span>
        </div>
      <% } %>
    </div>
    
    <!-- Search Bar -->
    <div style="margin-bottom: 20px;">
      <div class="form-group">
        <label for="admin-job-search-input">Buscar Trabalhos</label>
        <div style="display: flex; gap: 10px; align-items: center;">
          <input type="text" id="admin-job-search-input" placeholder="Filtrar trabalhos..." style="flex: 1; max-width: 400px;">
          <select id="admin-job-search-field" style="width: 100px;">
            <option value="all">Tudo</option>
            <option value="name">Nome</option>
            <option value="faction">Facção</option>
            <option value="description">Descrição</option>
            <option value="pilot">Piloto</option>
          </select>
          <button onclick="searchAdminJobs()" class="btn btn-primary">Buscar</button>
          <button onclick="clearAdminJobSearch()" class="btn btn-neutral">Limpar</button>
        </div>
      </div>
    </div>
    
    <!-- Filter Pills -->
    <div class="filter-pills">
      <button class="filter-pill active" data-state="all" onclick="filterJobs('all')">Todos</button>
      <% jobStates.forEach(state => { %>
        <button class="filter-pill" data-state="<%= state %>" onclick="filterJobs('<%= state %>')"><%= state %></button>
      <% }); %>
    </div>
    
    <div id="jobsList">
      <% jobs.forEach(job => { %>
        <div class="job-item" data-id="<%= job.id %>" data-state="<%= job.state || defaultJobState %>">
          <h3><%= job.name %> <span class="state-badge state-badge-<%= job.stateClass %>"><%= job.state || defaultJobState %></span></h3>
          <div class="job-item-field">
            <strong>Nível:</strong> 
            <span class="rank-display">
              <% for(let i = 0; i < job.rank; i++) { %><span class="star">★</span><% } %>
              <% for(let i = job.rank; i < 3; i++) { %><span class="star">☆</span><% } %>
            </span>
          </div>
          <div class="job-item-field"><strong>Facção:</strong> <%= job.faction ? job.faction.title : 'FIELD_NULL' %></div>
          <div class="job-item-field"><strong>Tipo de Trabalho:</strong> <%= job.jobType %></div>
          <div class="job-item-field"><strong>Objetivo:</strong> <%= job.description %></div>
          <div class="job-item-field"><strong>Resumo do Cliente:</strong> <%= job.clientBrief %></div>
          <div class="job-item-field"><strong>Pagamento:</strong>
            <%= job.currencyPay %>
            <img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon">
          </div>
          <% if (job.additionalPay) { %>
            <div class="job-item-field"><strong>Pagamento Adicional:</strong> <%= job.additionalPay %></div>
          <% } %>
          <% if (job.adminLog) { %>
            <div class="job-item-field"><strong>Registro do Administrador:</strong> <%= job.adminLog %></div>
          <% } %>
          <% if (job.emblem) { %>
            <div class="job-item-field">
              <strong>Emblema:</strong> <%= job.emblem %>
              <br>
              <img src="/emblems/<%= job.emblem %>" alt="<%= job.emblem.replace('.svg', '') %>" class="emblem-display">
            </div>
          <% } %>
          <div class="job-item-actions">
            <button class="btn btn-edit" onclick="editJob('<%= job.id %>')">Editar</button>
            <% if (job.state === 'Ativo') { %>
              <button class="btn btn-primary" onclick="markJobComplete('<%= job.id %>')">Marcar como Concluído</button>
              <button class="btn btn-delete" onclick="markJobFailed('<%= job.id %>')">Marcar como Falho</button>
            <% } %>
            <button class="btn btn-delete" onclick="deleteJob('<%= job.id %>')">Excluir</button>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  
  </div>
