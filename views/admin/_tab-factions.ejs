<div id="factions-tab" class="tab-content">
    <div class="add-job-section">
      <h2>Adicionar Nova Facção</h2>
      <form id="addFactionForm">
        <div class="form-group">
          <label for="factionTitle">Título da Facção</label>
          <input type="text" id="factionTitle" name="title" required>
        </div>
        
        <div class="form-group">
          <label for="factionBrief">Resumo</label>
          <textarea id="factionBrief" name="brief" required></textarea>
        </div>
        
        <div class="form-group">
          <label for="factionStanding">Reputação</label>
          <select id="factionStanding" name="standing" required>
            <option value="0">0 - Desconfiado</option>
            <option value="1">1 - Cauteloso</option>
            <option value="2" selected>2 - Neutro</option>
            <option value="3">3 - Respeitado</option>
            <option value="4">4 - Confiável</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="factionJobsCompletedOffset">Ajuste de Trabalhos Concluídos (Este número é adicionado à contagem de trabalhos concluídos)</label>
          <input type="number" id="factionJobsCompletedOffset" name="jobsCompletedOffset" value="0" required>
        </div>
        
        <div class="form-group">
          <label for="factionJobsFailedOffset">Ajuste de Trabalhos Falhos (Este número é adicionado à contagem de trabalhos falhos)</label>
          <input type="number" id="factionJobsFailedOffset" name="jobsFailedOffset" value="0" required>
        </div>

        <div class="form-group">
          <label for="factionAdminLog">Registro do Administrador</label>
          <textarea id="factionAdminLog" name="adminLog" rows="3" placeholder="Notas exclusivas do Mestre para esta facção"></textarea>
        </div>

        <div class="form-group">
          <label for="factionEmblem">Emblema</label>
          <input type="hidden" id="factionEmblem" name="emblem" value="">
          <div class="emblem-grid" id="factionEmblemGrid">
            <div class="emblem-option none" data-emblem="">
              [Nenhum]
            </div>
            <% emblems.forEach(emblem => { %>
              <div class="emblem-option" data-emblem="<%= emblem %>" title="<%= formatEmblemTitle(emblem) %>">
                <img src="/emblems/<%= emblem %>" alt="<%= formatEmblemTitle(emblem) %>">
              </div>
            <% }); %>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-add-job">Adicionar Facção</button>
      </form>
    </div>

    <div class="jobs-list">
      <h2>Facções Existentes</h2>
      <div id="factionsList">
        <% if (factions.length === 0) { %>
          <p style="color: #b0b0b0;">Nenhuma facção criada ainda.</p>
        <% } else { %>
          <% factions.forEach(faction => { 
            const standingLabels = ['Desconfiado', 'Cauteloso', 'Neutro', 'Respeitado', 'Confiável'];
          %>
            <div class="faction-item" data-id="<%= faction.id %>">
              <h3><%= faction.title %></h3>
              <div class="faction-item-field"><strong>Reputação:</strong> <%= standingLabels[faction.standing] || 'Desconhecido' %></div>
              <div class="faction-item-field"><strong>Trabalhos Concluídos:</strong> <%= faction.jobsCompleted || 0 %> (Ajuste: <%= faction.jobsCompletedOffset || 0 %>)</div>
              <div class="faction-item-field"><strong>Trabalhos Falhos:</strong> <%= faction.jobsFailed || 0 %> (Ajuste: <%= faction.jobsFailedOffset || 0 %>)</div>
              <div class="faction-item-field"><strong>Resumo:</strong> <%= faction.brief %></div>
              <% if (faction.adminLog) { %>
              <div class="faction-item-field"><strong>Registro do Administrador:</strong> <%= faction.adminLog %></div>
              <% } %>
              <% if (faction.emblem) { %>
                <div class="faction-item-field">
                  <strong>Emblema:</strong> <%= faction.emblem %>
                  <br>
                  <img src="/emblems/<%= faction.emblem %>" alt="<%= faction.emblem.replace('.svg', '') %>" class="emblem-display">
                </div>
              <% } %>
              <div class="faction-item-actions">
                <button class="btn btn-edit" onclick="editFaction('<%= faction.id %>')">Editar</button>
                <button class="btn btn-neutral" onclick="openFactionRelatedJobsModal('<%= faction.id %>')">Trabalhos Relacionados</button>
                <button class="btn btn-delete" onclick="deleteFaction('<%= faction.id %>')">Excluir</button>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
