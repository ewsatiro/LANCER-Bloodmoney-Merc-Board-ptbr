<div id="base-tab" class="tab-content">
    <div class="settings-section">
      <h2>Configuração de Instalações da Base</h2>
      <p style="color: #b0b0b0; margin-bottom: 20px;">Configure as instalações da base (3 vagas Principais, 6 Maiores, 6 Menores). Gerencie compras de instalações, melhorias e atribuições de vagas.</p>
      
      <!-- Facility Cost Modifier Section -->
      <div class="form-group" style="margin-bottom: 30px; max-width: 500px;">
        <label for="facilityCostModifier">Modificador de Custo de Instalação</label>
        <p style="color: #999; font-size: 12px; margin: 5px 0 10px 0;">Os preços são ajustados para 4 jogadores. Recomenda-se adicionar ou remover 20% para cada jogador extra ou ausente, respectivamente.</p>
        <div style="display: flex; align-items: center; gap: 10px;">
          <input type="number" 
                 id="facilityCostModifier" 
                 name="facilityCostModifier" 
                 value="<%= settings.facilityCostModifier || 0 %>" 
                 min="-100" 
                 max="300" 
                 step="5"
                 style="width: 100px;">
          <span style="color: #e0e0e0;">%</span>
          <button type="button" class="btn" onclick="updateFacilityCostModifier()" style="margin-left: 10px;">Atualizar Modificador</button>
        </div>
      </div>
      
      <!-- Core Facilities Section -->
      <h3 style="color: #e0e0e0; margin-bottom: 15px;">Instalações Core (3)</h3>
      <div class="facility-grid">
        <% coreMajorFacilities.slice(0, 3).forEach((facility, index) => { %>
          <div class="facility-card" data-facility-index="<%= index %>">
            <div class="facility-header">
              <h4><%= facility.facilityName %></h4>
              <label class="purchased-toggle">
                <input type="checkbox" 
                       <%= facility.isPurchased ? 'checked' : '' %> 
                       disabled
                       title="Instalações Core são sempre adquiridas">
                <span>Adquirida</span>
              </label>
            </div>
            <p class="facility-description"><%= facility.facilityDescription %></p>
            
            <% if (facility.upgrades && facility.upgrades.length > 0) { %>
              <div class="upgrades-section">
                <h5>Melhorias</h5>
                <% facility.upgrades.forEach((upgrade, upgradeIndex) => { %>
                  <div class="upgrade-item">
                    <div class="upgrade-info">
                      <strong><%= upgrade.upgradeName %></strong>
                      <span class="upgrade-price"><%= upgrade.upgradePrice %><img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon"></span>
                    </div>
                    <p class="upgrade-description"><%= upgrade.upgradeDescription %></p>
                    <div class="upgrade-count">
                      <label>Adquiridas:</label>
                      <input type="number" 
                             class="upgrade-count-input"
                             value="<%= upgrade.upgradeCount %>"
                             min="0"
                             max="<%= upgrade.maxPurchases %>"
                             data-facility-index="<%= index %>"
                             data-upgrade-index="<%= upgradeIndex %>"
                             onchange="updateUpgradeCount(this)">
                      <span>/ <%= upgrade.maxPurchases %></span>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
      
      <!-- Major Facilities Section -->
      <h3 style="color: #e0e0e0; margin: 20px 0 15px;">Instalações Major (6)</h3>
      <div class="facility-grid">
        <% coreMajorFacilities.slice(3, 9).forEach((facility, localIndex) => { 
           const index = localIndex + 3;
        %>
          <div class="facility-card" data-facility-index="<%= index %>">
            <div class="facility-header">
              <h4><%= facility.facilityName %></h4>
              <label class="purchased-toggle">
                <input type="checkbox" 
                       <%= facility.isPurchased ? 'checked' : '' %>
                       data-facility-index="<%= index %>"
                       onchange="toggleFacilityPurchased(this)">
                <span>Adquirida</span>
              </label>
            </div>
            <div class="facility-price">Preço: <%= facility.facilityPrice %><img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon"></div>
            <p class="facility-description"><%= facility.facilityDescription %></p>
            
            <% if (facility.upgrades && facility.upgrades.length > 0) { %>
              <div class="upgrades-section">
                <h5>Melhorias</h5>
                <% facility.upgrades.forEach((upgrade, upgradeIndex) => { %>
                  <div class="upgrade-item">
                    <div class="upgrade-info">
                      <strong><%= upgrade.upgradeName %></strong>
                      <span class="upgrade-price"><%= upgrade.upgradePrice %><img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon"></span>
                    </div>
                    <p class="upgrade-description"><%= upgrade.upgradeDescription %></p>
                    <div class="upgrade-count">
                      <label>Adquiridas:</label>
                      <input type="number" 
                             class="upgrade-count-input"
                             value="<%= upgrade.upgradeCount %>"
                             min="0"
                             max="<%= upgrade.maxPurchases %>"
                             data-facility-index="<%= index %>"
                             data-upgrade-index="<%= upgradeIndex %>"
                             onchange="updateUpgradeCount(this)">
                      <span>/ <%= upgrade.maxPurchases %></span>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
      
      <!-- Minor Facilities Section -->
      <h3 style="color: #e0e0e0; margin: 20px 0 15px;">Slots de Instalações Minor (6)</h3>
      <p style="color: #b0b0b0; margin-bottom: 15px;">Os últimos 2 slots podem ser ativados/desativados. Clique em "Atribuir" para selecionar entre as instalações Minor disponíveis.</p>
      <div class="facility-grid">
        <% minorFacilitiesSlots.slots.forEach((slot, slotIndex) => { %>
          <div class="facility-card minor-slot <%= !slot.enabled ? 'disabled-facility' : '' %>" data-slot-number="<%= slot.slotNumber %>">
            <div class="facility-header">
              <h4>Slot Minor <%= slot.slotNumber %></h4>
              <% if (slotIndex >= 4) { %>
                <label class="enabled-toggle">
                  <input type="checkbox" 
                         <%= slot.enabled ? 'checked' : '' %>
                         data-slot-number="<%= slot.slotNumber %>"
                         onchange="toggleMinorSlotEnabled(this)">
                  <span>Ativado</span>
                </label>
              <% } %>
            </div>
            
            <% if (slot.enabled) { %>
              <% if (slot.facilityName) { %>
                <div class="assigned-facility">
                  <h5><%= slot.facilityName %></h5>
                  <p class="facility-description"><%= slot.facilityDescription %></p>
                  <button class="btn btn-delete btn-sm" onclick="clearMinorSlot(<%= slot.slotNumber %>)">Limpar Slot</button>
                </div>
              <% } else { %>
                <div class="empty-slot">
                  <p style="color: #888; text-align: center; padding: 20px;">Nenhuma instalação atribuída</p>
                  <button class="btn btn-primary btn-sm" onclick="openMinorFacilityAssignModal(<%= slot.slotNumber %>)">Atribuir Instalação</button>
                </div>
              <% } %>
            <% } else { %>
              <p style="color: #666; text-align: center; padding: 20px;">Este slot está desativado</p>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
