            <option value="2">Nível 2</option>
            <option value="3">Nível 3</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="createReserveName">Nome</label>
          <input type="text" id="createReserveName" name="name" required>
        </div>
        
