          <label for="createReserveAdminLog">Registro do Administrador</label>
          <textarea id="createReserveAdminLog" name="adminLog" rows="3" placeholder="Notas exclusivas do Mestre para esta reserva"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Criar Reserva</button>
      </form>
    </div>
  </div>

  <!-- Edit Reserve Modal -->
  <div id="editReserveModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Reserva</h2>
        <span class="close" onclick="closeEditReserveModal()">&times;</span>
      </div>
      <form id="editReserveForm">
        <input type="hidden" id="editReserveId">
        
        <div class="form-group">
          <label for="editReserveRank">Nível (1-3)</label>
          <select id="editReserveRank" name="rank" required>
            <option value="1">Nível 1</option>
            <option value="2">Nível 2</option>
            <option value="3">Nível 3</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="editReserveName">Nome</label>
          <input type="text" id="editReserveName" name="name" required>
        </div>
        
        <div class="form-group">
          <label for="editReservePrice">Preço</label>
          <input type="number" id="editReservePrice" name="price" min="0" required>
        </div>
        
        <div class="form-group">
          <label for="editReserveDescription">Descrição</label>
          <textarea id="editReserveDescription" name="description" rows="4"></textarea>
        </div>

        <div class="form-group">
          <label for="editReserveAdminLog">Registro do Administrador</label>
          <textarea id="editReserveAdminLog" name="adminLog" rows="3" placeholder="Notas exclusivas do Mestre para esta reserva"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </form>
    </div>
  </div>

  <!-- Currency Icon Selection Modal -->
  <div id="currencyIconModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Selecionar Ícone de Moeda</h2>
        <span class="close" onclick="closeCurrencyIconModal()">&times;</span>
      </div>
      <div style="padding: 20px;">
        <p style="color: #b0b0b0; margin-bottom: 15px;">
          Selecione um ícone SVG da biblioteca de emblemas para usar como ícone de moeda. O ícone selecionado será usado em toda a aplicação.
        </p>
        <div class="emblem-grid" id="currencyIconGrid">
          <% emblems.forEach(emblem => { %>
            <div class="emblem-option" data-emblem="<%= emblem %>" title="<%= formatEmblemTitle(emblem) %>">
              <img src="/emblems/<%= emblem %>" alt="<%= formatEmblemTitle(emblem) %>">
            </div>
          <% }); %>
        </div>
        <div style="margin-top: 20px; text-align: right;">
          <button type="button" class="btn btn-secondary" onclick="closeCurrencyIconModal()">Cancelar</button>
          <button type="button" class="btn btn-primary" onclick="saveCurrencyIcon()">Salvar</button>
        </div>
      </div>
    </div>
  </div>
  <!-- Modify Voting Close Modal -->
  <div id="modify-vote-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Modificar Horário de Encerramento da Votação</h2>
        <span class="close" onclick="closeModifyVoteModal()">&times;</span>
      </div>
      <div class="form-group">
        <label for="modify-vote-end-time">Novo Horário de Encerramento</label>
        <div style="display: flex; align-items: center; gap: 10px;">
          <input type="datetime-local" id="modify-vote-end-time" style="flex: 1; color-scheme: dark;">
          <label style="display: flex; align-items: center; gap: 5px; color: #b0b0b0; cursor: pointer; white-space: nowrap;">
            <input type="checkbox" id="modify-vote-infinite-duration" onchange="toggleModifyEndTime(this)">
            Sem horário de encerramento?
          </label>
        </div>
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-primary" onclick="modifyVotingClose()">Atualizar Horário de Encerramento</button>
        <button type="button" class="btn btn-secondary" onclick="closeModifyVoteModal()">Cancelar</button>
      </div>
    </div>
  </div>
