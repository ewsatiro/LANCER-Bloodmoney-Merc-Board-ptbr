<!-- Notification Footer -->
  <div id="notificationFooter" class="notification-footer"></div>

  <!-- Edit Modal -->
  <div id="editModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Trabalho</h2>
        <span class="close" onclick="closeEditModal()">&times;</span>
      </div>
      <form id="editJobForm">
        <input type="hidden" id="editJobId">
        <div class="form-group">
          <label for="editJobName">Nome do Trabalho</label>
          <input type="text" id="editJobName" name="name" required>
        </div>
        
        <div class="form-group">
          <label for="editJobRank">Nível do Trabalho (1-3 estrelas)</label>
          <select id="editJobRank" name="rank" required>
            <option value="1">1 Estrela</option>
            <option value="2">2 Estrelas</option>
            <option value="3">3 Estrelas</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="editJobState">Estado do Trabalho</label>
          <select id="editJobState" name="state" required>
            <% jobStates.forEach(state => { %>
              <option value="<%= state %>"><%= state %></option>
            <% }); %>
          </select>
        </div>
        
        <div class="form-group">
          <label for="editJobFaction">Facção (Opcional)</label>
          <select id="editJobFaction" name="factionId">
            <option value="">Nenhuma</option>
            <% factions.forEach(faction => { %>
              <option value="<%= faction.id %>"><%= faction.title %></option>
            <% }); %>
          </select>
        </div>
        
        <div class="form-group">
          <label for="editJobType">Tipo de Trabalho</label>
          <input type="text" id="editJobType" name="jobType" required>
        </div>
        
        <div class="form-group">
          <label for="editJobDescription">Objetivo</label>
          <textarea id="editJobDescription" name="description" required></textarea>
        </div>
        
        <div class="form-group">
          <label for="editJobClientBrief">Resumo do Cliente</label>
          <textarea id="editJobClientBrief" name="clientBrief" required></textarea>
        </div>
        
        <div class="form-group">
          <label for="editJobCurrencyPay" class="currency-label">
            Pagamento em Moeda (ex.: 100m)
            <img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon">
          </label>
          <input type="text" id="editJobCurrencyPay" name="currencyPay" required>
        </div>

        <div class="form-group">
          <label for="editJobAdditionalPay">Pagamento Adicional</label>
          <input type="text" id="editJobAdditionalPay" name="additionalPay">
        </div>

        <div class="form-group">
          <label for="editJobAdminLog">Registro do Administrador</label>
          <textarea id="editJobAdminLog" name="adminLog" rows="3" placeholder="Notas exclusivas do Mestre para este trabalho"></textarea>
        </div>

        <div class="form-group">
          <label for="editJobEmblem">Emblema</label>
          <input type="hidden" id="editJobEmblem" name="emblem" value="">
          <div class="emblem-grid" id="editEmblemGrid">
            <div class="emblem-option none" data-emblem="">
              [Nenhum]
            </div>
            <% emblems.forEach(emblem => { %>
              <div class="emblem-option" data-emblem="<%= emblem %>" title="<%= formatEmblemTitle(emblem) %>">
                <img src="/emblems/<%= emblem %>" alt="<%= formatEmblemTitle(emblem) %>">
              </div>
            <% }); %>
          </div>
        </div>
        
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </form>
    </div>
  </div>
  <!-- Edit Faction Modal -->
  <div id="editFactionModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Facção</h2>
        <span class="close" onclick="closeEditFactionModal()">&times;</span>
      </div>
      <form id="editFactionForm">
        <input type="hidden" id="editFactionId">
        <div class="form-group">
          <label for="editFactionTitle">Título da Facção</label>
          <input type="text" id="editFactionTitle" name="title" required>
        </div>
        
        <div class="form-group">
          <label for="editFactionBrief">Resumo</label>
          <textarea id="editFactionBrief" name="brief" required></textarea>
        </div>
        
        <div class="form-group">
          <label for="editFactionStanding">Reputação</label>
          <select id="editFactionStanding" name="standing" required>
            <option value="0">0 - Desconfiado</option>
            <option value="1">1 - Cauteloso</option>
            <option value="2">2 - Neutro</option>
            <option value="3">3 - Respeitado</option>
            <option value="4">4 - Confiável</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="editFactionJobsCompletedOffset">Ajuste de Trabalhos Concluídos (calculado a partir dos trabalhos + este ajuste)</label>
          <input type="number" id="editFactionJobsCompletedOffset" name="jobsCompletedOffset" required>
        </div>
        
        <div class="form-group">
          <label for="editFactionJobsFailedOffset">Ajuste de Trabalhos Falhos (calculado a partir dos trabalhos + este ajuste)</label>
          <input type="number" id="editFactionJobsFailedOffset" name="jobsFailedOffset" required>
        </div>

        <div class="form-group">
          <label for="editFactionAdminLog">Registro do Administrador</label>
          <textarea id="editFactionAdminLog" name="adminLog" rows="3" placeholder="Notas exclusivas do Mestre para esta facção"></textarea>
        </div>

        <div class="form-group">
          <label for="editFactionEmblem">Emblema</label>
          <input type="hidden" id="editFactionEmblem" name="emblem" value="">
          <div class="emblem-grid" id="editFactionEmblemGrid">
            <div class="emblem-option none" data-emblem="">
              [Nenhum]
            </div>
            <% emblems.forEach(emblem => { %>
              <div class="emblem-option" data-emblem="<%= emblem %>" title="<%= formatEmblemTitle(emblem) %>">
                <img src="/emblems/<%= emblem %>" alt="<%= formatEmblemTitle(emblem) %>">
              </div>
            <% }); %>
          </div>
        </div>
        
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </form>
    </div>
  </div>
  
  <!-- Edit Transaction Modal -->
  <div id="editTransactionModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Transação</h2>
        <span class="close" onclick="closeEditTransactionModal()">&times;</span>
      </div>
      <form id="editTransactionForm">
        <input type="hidden" id="editTransactionId">
        <div class="form-group">
          <label for="editTransactionDate">Data</label>
          <input type="datetime-local" id="editTransactionDate" name="date" required>
        </div>
        
        <div class="form-group">
          <label for="editTransactionAmount">Valor (+ ou -)</label>
          <input type="number" id="editTransactionAmount" name="amount" required>
        </div>
        
        <div class="form-group">
          <label for="editTransactionDescription">Descrição</label>
          <input type="text" id="editTransactionDescription" name="description" required>
        </div>
        
        <p style="color: #b0b0b0; margin: 10px 0;">
          <em>Nota: Editar transações não afeta as associações com pilotos. Use o botão "Selecionar Piloto(s)" para alterar as atribuições de pilotos.</em>
        </p>
        
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </form>
    </div>
  </div>
  
  <!-- Pilot Selection Modal -->
  <div id="pilotSelectionModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Selecionar Piloto(s)</h2>
        <span class="close" onclick="closePilotSelectionModal()">&times;</span>
      </div>
      <div id="pilotSelectionList" style="max-height: 400px; overflow-y: auto;">
        <% if (pilots.length === 0) { %>
          <p style="color: #b0b0b0;">Nenhum piloto disponível.</p>
        <% } else { %>
          <% pilots.sort((a, b) => {
            if (a.active !== b.active) return b.active ? 1 : -1;
            return a.name.localeCompare(b.name);
          }).forEach(pilot => { %>
            <div style="margin-bottom: 10px; padding: 10px; background-color: <%= pilot.active ? '#1a1a1a' : '#2a2a2a' %>; border-radius: 3px;">
              <label style="display: flex; align-items: center; cursor: pointer; color: <%= pilot.active ? '#e0e0e0' : '#888' %>;">
                <input type="checkbox" class="pilot-checkbox" value="<%= pilot.id %>" style="margin-right: 10px; width: auto;">
                <span><%= pilot.name %> (<%= pilot.callsign %>)<%= pilot.active ? '' : ' - Inativo' %></span>
              </label>
            </div>
          <% }); %>
        <% } %>
      </div>
      <div style="margin-top: 20px;">
        <button type="button" class="btn btn-primary" onclick="confirmPilotSelection()">Confirmar Seleção</button>
        <button type="button" class="btn btn-neutral" onclick="closePilotSelectionModal()">Cancelar</button>
      </div>
    </div>
  </div>
  
  <!-- Edit Pilot Modal -->
  <div id="editPilotModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Piloto</h2>
        <span class="close" onclick="closeEditPilotModal()">&times;</span>
      </div>
      <form id="editPilotForm">
        <input type="hidden" id="editPilotId">
        <div class="form-group">
          <label for="editPilotName">Nome</label>
          <input type="text" id="editPilotName" name="name" required>
        </div>
        
        <div class="form-group">
          <label for="editPilotCallsign">Codinome</label>
          <input type="text" id="editPilotCallsign" name="callsign" required>
        </div>
        
        <div class="form-group">
          <label for="editPilotLL">Nível de Licença (0-12)</label>
          <input type="number" id="editPilotLL" name="ll" min="0" max="12" required>
        </div>
        
        <div class="form-group">
          <label for="editPilotNotes">Notas (multilinha)</label>
          <textarea id="editPilotNotes" name="notes" rows="4"></textarea>
        </div>

        <div class="form-group">
          <label for="editPilotAdminLog">Registro do Administrador</label>
          <textarea id="editPilotAdminLog" name="adminLog" placeholder="Notas exclusivas do Mestre para este piloto" rows="4"></textarea>
        </div>
        
        <div class="form-group" id="editPilotPersonalOperationProgressGroup" style="display: <%= settings.openTable ? 'block' : 'none' %>">
          <label for="editPilotPersonalOperationProgress">Progresso Pessoal da Operação</label>
          <select id="editPilotPersonalOperationProgress" name="personalOperationProgress">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
          </select>
        </div>
        
        <div class="form-group">
          <label style="display: block; cursor: pointer;">
            <span style="display: inline; margin-right: 8px;">Ativo:</span>
            <input type="checkbox" id="editPilotActive" name="active" value="true" style="width: auto;">
          </label>
        </div>
        
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </form>
    </div>
  </div>
  
  <!-- Pilot Related Jobs Modal -->
  <div id="pilotRelatedJobsModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Trabalhos Relacionados ao Piloto</h2>
        <span class="close" onclick="closePilotRelatedJobsModal()">&times;</span>
      </div>
      <input type="hidden" id="pilotRelatedJobsPilotId">
      <p style="color: #b0b0b0; margin-bottom: 15px;">Selecione trabalhos para associar a este piloto (somente trabalhos que não estejam Pendentes):</p>
      <div id="pilotRelatedJobsList" style="max-height: 400px; overflow-y: auto; border: 1px solid #444; padding: 15px; border-radius: 3px; background-color: #1a1a1a;">
        <!-- Populated dynamically -->
      </div>
      <div style="margin-top: 15px;">
        <button class="btn btn-primary" onclick="savePilotRelatedJobs()">Salvar Trabalhos Relacionados</button>
      </div>
    </div>
  </div>
  
  <!-- Pilot Balance History Modal -->
  <div id="pilotBalanceHistoryModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Histórico de Saldo do Piloto</h2>
        <span class="close" onclick="closePilotBalanceHistoryModal()">&times;</span>
      </div>
      <input type="hidden" id="pilotBalanceHistoryPilotId">
      <div style="margin-bottom: 15px;">
        <div class="job-item-field">
          <strong>Saldo Atual:</strong> 
          <span id="pilotBalanceHistoryTotal">0</span>
          <img src="/emblems/<%= settings.currencyIcon || 'manna_symbol.svg' %>" alt="Ícone de Moeda" class="currency-icon">
        </div>
      </div>
      <p style="color: #b0b0b0; margin-bottom: 15px;">Desmarque transações para desassociá-las deste piloto. A transação permanecerá no sistema.</p>
      <div id="pilotBalanceHistoryList" style="max-height: 400px; overflow-y: auto; border: 1px solid #444; padding: 15px; border-radius: 3px; background-color: #1a1a1a;">
        <!-- Populated dynamically -->
      </div>
      <div style="margin-top: 15px;">
        <button class="btn btn-primary" onclick="savePilotBalanceHistory()">Salvar Alterações</button>
      </div>
    </div>
  </div>
  
  <!-- Pilot Reserves Modal -->
  <div id="pilotReservesModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Reservas do Piloto</h2>
        <span class="close" onclick="closePilotReservesModal()">&times;</span>
      </div>
      <input type="hidden" id="pilotReservesModalPilotId">
      <p style="color: #b0b0b0; margin-bottom: 15px;">Gerencie as reservas pertencentes a este piloto. Clique nos cards para selecionar/desselecionar.</p>
      
      <!-- Reserve Action Buttons -->
      <div style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
        <button class="btn btn-neutral" onclick="setSelectedReservesStatus('In Reserve')" id="setInReserveBtn" disabled>Definir como Em Reserva</button>
        <button class="btn btn-neutral" onclick="setSelectedReservesStatus('Deployed')" id="setDeployedBtn" disabled>Definir como Implantado</button>
        <button class="btn btn-neutral" onclick="setSelectedReservesStatus('Expended')" id="setExpendedBtn" disabled>Definir como Consumido</button>
        <button class="btn btn-delete" onclick="removeSelectedReservesFromPilot()" id="removeReservesBtn" disabled>Remover Reserva</button>
        <button class="btn btn-primary" onclick="openAddReservesToPilotModal()">Adicionar Reserva</button>
      </div>
      
      <!-- Pilot Reserves Grid -->
      <div id="pilotReservesGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; min-height: 100px; max-height: 500px; overflow-y: auto; border: 1px solid #444; padding: 15px; border-radius: 3px; background-color: #1a1a1a;">
        <!-- Populated dynamically -->
      </div>
    </div>
  </div>
  
  <!-- Add Reserves to Pilot Modal (Sub-modal) -->
  <div id="addReservesToPilotModal" class="modal">
    <div class="modal-content" style="max-width: 1200px;">
      <div class="modal-header">
        <h2>Adicionar Reservas ao Piloto</h2>
        <span class="close" onclick="closeAddReservesToPilotModal()">&times;</span>
      </div>
      <p style="color: #b0b0b0; margin-bottom: 15px;">Selecione reservas para adicionar a este piloto. Clique nos cards para selecionar/desselecionar.</p>
      
      <div style="margin-bottom: 15px;">
        <button class="btn btn-primary" onclick="addSelectedStockReservesToPilot()" id="addStockReservesBtn" disabled>Adicionar Selecionadas ao Piloto</button>
      </div>
      
      <!-- Filter Pills -->
      <div class="filter-pills" style="margin-bottom: 15px;">
        <button class="filter-pill active" data-rank="all" onclick="filterPilotAddReserves('all', event)" id="pilotAddFilterAll">Todas</button>
        <button class="filter-pill" data-rank="1" onclick="filterPilotAddReserves('1', event)" id="pilotAddFilterRank1">Nível 1</button>
        <button class="filter-pill" data-rank="2" onclick="filterPilotAddReserves('2', event)" id="pilotAddFilterRank2">Nível 2</button>
        <button class="filter-pill" data-rank="3" onclick="filterPilotAddReserves('3', event)" id="pilotAddFilterRank3">Nível 3</button>
        <button class="filter-pill" data-hide-default="false" onclick="togglePilotAddHideDefault(event)" id="pilotAddHideDefaultPill">Ocultar Reservas Padrão</button>
      </div>
      
      <!-- Search Field -->
      <div class="form-group" style="margin-bottom: 15px;">
        <label for="pilotAddReserveSearchInput">Buscar Reservas</label>
        <input type="text" id="pilotAddReserveSearchInput" placeholder="Buscar por nome..." oninput="searchPilotAddReserves(this.value)" style="max-width: 400px;">
      </div>
      
      <!-- Available Reserves Grid -->
      <div id="addReservesStockGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; min-height: 100px; max-height: 500px; overflow-y: auto; border: 1px solid #444; padding: 15px; border-radius: 3px; background-color: #1a1a1a;">
        <!-- Populated dynamically -->
      </div>
    </div>
  </div>
  
  <!-- Faction Related Jobs Modal -->
  <div id="factionRelatedJobsModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Trabalhos Relacionados à Facção</h2>
        <span class="close" onclick="closeFactionRelatedJobsModal()">&times;</span>
      </div>
      <p style="color: #b0b0b0; margin-bottom: 15px;">Trabalhos relacionados a esta facção:</p>
      <div id="factionRelatedJobsList" style="max-height: 400px; overflow-y: auto;">
        <!-- Populated dynamically -->
      </div>
    </div>
  </div>
  
  <!-- Progress All Jobs Confirmation Modal -->
  <div id="progressAllJobsModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Confirmar: Avançar Todos os Trabalhos</h2>
        <span class="close" onclick="closeProgressAllJobsModal()">&times;</span>
      </div>
      <div style="color: #e0e0e0; line-height: 1.6;">
        <p style="margin-bottom: 15px;">Esta ação irá:</p>
        <ul style="margin-left: 20px; margin-bottom: 15px;">
          <li>Definir todos os trabalhos <strong>"Ativos"</strong> como <strong>"Ignorados"</strong></li>
          <li>Definir todos os trabalhos <strong>"Pendentes"</strong> como <strong>"Ativos"</strong></li>
          <li>Adicionar os trabalhos recém-ativados a todas as listas de trabalhos relacionados dos <strong>Pilotos Ativos</strong> no momento</li>
        </ul>
        
        <h3 style="margin: 20px 0 10px; color: #e0e0e0;">Trabalhos que serão afetados:</h3>
        <div id="progressAllJobsList" style="max-height: 50vh; overflow-y: auto; border: 1px solid #444; padding: 15px; border-radius: 3px; background-color: #1a1a1a; margin-bottom: 15px;">
          <!-- Populated dynamically -->
        </div>
        
        <p style="margin-bottom: 20px; color: #f44336; font-weight: bold;">Esta ação não pode ser desfeita.</p>
        <div style="display: flex; gap: 10px;">
          <button class="btn btn-primary" onclick="confirmProgressAllJobs()">Confirmar</button>
          <button class="btn btn-neutral" onclick="closeProgressAllJobsModal()">Cancelar</button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Progress Operation Modal -->
  <div id="progressOperationModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Confirmar: Avançar a Trilha de Operação dos Pilotos Ativos</h2>
        <span class="close" onclick="closeProgressOperationModal()">&times;</span>
      </div>
      <div style="color: #e0e0e0; line-height: 1.6;">
        <p style="margin-bottom: 15px;">Esta ação irá incrementar o <strong>Progresso Pessoal da Operação</strong> dos seguintes <strong>Pilotos Ativos</strong>:</p>
        <div id="progressOperationPilotList" style="margin-bottom: 15px; max-height: 50vh; overflow-y: auto; border: 1px solid #555; padding: 10px; background-color: #1a1a1a;">
          <!-- Pilot list will be populated dynamically -->
        </div>
        <p style="margin-bottom: 20px; color: #f44336; font-weight: bold;">Esta ação não pode ser desfeita.</p>
        <div style="display: flex; gap: 10px;">
          <button class="btn btn-primary" onclick="confirmProgressOperation()">Confirmar</button>
          <button class="btn btn-neutral" onclick="closeProgressOperationModal()">Cancelar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Minor Facility Assignment Modal -->
  <div id="minorFacilityAssignModal" class="modal">
    <div class="modal-content" style="max-width: 800px;">
      <div class="modal-header">
