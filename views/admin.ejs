<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>>Quadro de Empregos LANCER - Administração</title>
  <link rel="stylesheet" href="/css/currency.css">
  <%- include('admin/_styles') %>
</head><body><div class="admin-header">
    <h1>Quadro de Empregos LANCER - Painel Administrativo</h1>
    <p>Gerencie anúncios de trabalhos, instalações da base, facções e configurações globais</p>
    <a href="/logout" class="logout-link">Sair</a>
  </div>
  <!-- Navegação por Abas -->
  <div class="tab-navigation">
    <button class="tab-button active" onclick="switchTab('overview', event)">Configuração de Visão Geral</button>
    <button class="tab-button" onclick="switchTab('transactions', event)">Gerenciamento de Transações</button>
    <button class="tab-button" onclick="switchTab('jobs', event)">Configuração do Quadro de Empregos</button>
    <button class="tab-button" onclick="switchTab('vote', event)">Configuração de Votação</button>
    <button class="tab-button" onclick="switchTab('factions', event)">Configuração de Facções</button>
    <button class="tab-button" onclick="switchTab('base', event)">Configuração de Base</button>
    <button class="tab-button" onclick="switchTab('pilots', event)">Configuração de Pilotos</button>
    <button class="tab-button" onclick="switchTab('store', event)">Configuração de Loja e Reservas</button>
  </div>

  <%- include('admin/_tab-overview') %>
  <%- include('admin/_tab-transactions') %>
  <%- include('admin/_tab-jobs') %>
  <%- include('admin/_tab-base') %>
  <%- include('admin/_tab-pilots') %>
  <%- include('admin/_tab-factions') %>
  <%- include('admin/_tab-store') %>
  <%- include('admin/_tab-vote') %>
  <%- include('admin/_modals') %>
  <%- include('admin/_scripts') %>
</body></html>
